{
  "title": "Citrix",
  "rules": [
    {
      "description": "Citrix (Go back in page)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.citrix\\.receiver\\.icaviewer\\.mac$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "h",
            "modifiers": { "mandatory": ["left_control", "left_command"] }
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": ["left_option", "left_command"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Citrix (Go forward in page)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.citrix\\.receiver\\.icaviewer\\.mac$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "l",
            "modifiers": { "mandatory": ["left_control", "left_command"] }
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": ["left_option", "left_command"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Citrix (Remap F13 to Screenshot)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.citrix\\.receiver\\.icaviewer\\.mac$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "f13"
          },
          "to": [
            {
              "key_code": "s",
              "modifiers": ["right_command", "left_shift"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Citrix (Shift Window to the Left)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.citrix\\.receiver\\.icaviewer\\.mac$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "f15"
          },
          "to": [
            {
              "key_code": "left_arrow",
              "modifiers": ["right_command"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Citrix (Shift Window to the Right)",
      "manipulators": [
        {
          "conditions": [
            {
              "bundle_identifiers": [
                "^com\\.citrix\\.XenAppViewer$",
                "^com\\.citrix\\.receiver\\.icaviewer\\.mac$"
              ],
              "type": "frontmost_application_if"
            }
          ],
          "from": {
            "key_code": "f16"
          },
          "to": [
            {
              "key_code": "right_arrow",
              "modifiers": ["right_command"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
