{
  "title": "Mouse",
  "rules": [
    {
      "description": "Trigger left mouse click on quick tap of left_control",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_control",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 250
          },
          "to_if_alone": [
            {
              "pointing_button": "button1"
            }
          ],
          "to": [
            {
              "key_code": "left_control"
            }
          ]
        }
      ]
    }
  ]
}
