{
  "title": "Mouse",
  "rules": [
    {
      "description": "Trigger left mouse click on double press of left_control",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "pointing_button": "button1"
            }
          ],
          "conditions": [
            {
              "type": "variable_if",
              "name": "is_left_command_pressed",
              "value": 1
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "left_command",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "is_left_command_pressed",
                "value": 1
              }
            },
            {
              "key_code": "left_command"
            }
          ],
          "to_delayed_action": {
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "is_left_command_pressed",
                  "value": 0
                }
              }
            ],
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "is_left_command_pressed",
                  "value": 0
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
