{
  "title": "Keyboard",
  "rules": [
    {
      "description": "Change left_alt+hjkl to arrow keys",
      "manipulators": [
        {
          "from": {
            "key_code": "h",
            "modifiers": {
              "mandatory": ["left_alt"],
              "optional": ["any"]
            }
          },
          "to": [{ "key_code": "left_arrow" }],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "j",
            "modifiers": {
              "mandatory": ["left_alt"],
              "optional": ["any"]
            }
          },
          "to": [{ "key_code": "down_arrow" }],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "k",
            "modifiers": {
              "mandatory": ["left_alt"],
              "optional": ["any"]
            }
          },
          "to": [{ "key_code": "up_arrow" }],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "l",
            "modifiers": {
              "mandatory": ["left_alt"],
              "optional": ["any"]
            }
          },
          "to": [{ "key_code": "right_arrow" }],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Double left Shift to toggle Caps Lock",
      "manipulators": [
        {
          "conditions": [
            {
              "name": "left_shift pressed",
              "type": "variable_if",
              "value": 1
            }
          ],
          "from": {
            "key_code": "left_shift",
            "modifiers": { "optional": ["any"] }
          },
          "to": [{ "key_code": "caps_lock" }],
          "type": "basic"
        },
        {
          "from": {
            "key_code": "left_shift",
            "modifiers": { "optional": ["any"] }
          },
          "to": [
            {
              "set_variable": {
                "name": "left_shift pressed",
                "value": 1
              }
            },
            { "key_code": "left_shift" }
          ],
          "to_delayed_action": {
            "to_if_canceled": [
              {
                "set_variable": {
                  "name": "left_shift pressed",
                  "value": 0
                }
              }
            ],
            "to_if_invoked": [
              {
                "set_variable": {
                  "name": "left_shift pressed",
                  "value": 0
                }
              }
            ]
          },
          "type": "basic"
        }
      ]
    },
    {
      "description": "Remap F13 to Screenshot (Cmd+Shift+4)",
      "manipulators": [
        {
          "from": {
            "key_code": "f13"
          },
          "to": [
            {
              "key_code": "4",
              "modifiers": ["left_command", "left_shift"]
            }
          ],
          "type": "basic"
        }
      ]
    },
    {
      "description": "Remap F14 to Screenshot (Cmd+Shift+5)",
      "manipulators": [
        {
          "from": {
            "key_code": "f14"
          },
          "to": [
            {
              "key_code": "5",
              "modifiers": ["left_command", "left_shift"]
            }
          ],
          "type": "basic"
        }
      ]
    }
  ]
}
