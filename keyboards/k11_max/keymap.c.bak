// clang-format on
bool process_record_user(uint16_t keycode, keyrecord_t *record) {
    if (!process_record_keychron_common(keycode, record)) {
        return false;
    }
    return true;
}

// Set RGB based on current layer
bool rgb_matrix_indicators_user(void) {
    uint8_t current_layer = get_highest_layer(layer_state);

    switch (current_layer) {
        case MAC_FN1:
        case WIN_FN1:
            rgb_matrix_set_color_all(0, 0, 0);
            rgb_matrix_set_color(7, 255, 0, 0); // 7
            rgb_matrix_set_color(8, 255, 0, 0); // 8
            rgb_matrix_set_color(9, 255, 0, 0); // 9
            rgb_matrix_set_color(10, 255, 0, 0); // 0
            rgb_matrix_set_color(11, 255, 125, 0); // -/_
            rgb_matrix_set_color(12, 255, 125, 0); // =/+

            rgb_matrix_set_color(15, 0, 255, 0); // q
            rgb_matrix_set_color(16, 0, 255, 0); // w
            rgb_matrix_set_color(17, 0, 255, 0); // e
            rgb_matrix_set_color(18, 0, 255, 0); // r

            rgb_matrix_set_color(20, 0, 0, 255); // y
            rgb_matrix_set_color(21, 0, 0, 255); // u
            rgb_matrix_set_color(22, 0, 0, 255); // i
            rgb_matrix_set_color(23, 0, 0, 255); // o
            rgb_matrix_set_color(24, 0, 0, 255); // p

            rgb_matrix_set_color(29, 0, 0, 255); // caps

            rgb_matrix_set_color(35, 0, 0, 255); // h
            rgb_matrix_set_color(36, 0, 0, 255); // j
            rgb_matrix_set_color(37, 0, 0, 255); // k
            rgb_matrix_set_color(38, 0, 0, 255); // l
            rgb_matrix_set_color(39, 0, 0, 255); // :/;
            break;
        case FN2:
            rgb_matrix_set_color_all(0, 0, 0);
            rgb_matrix_set_color(1, 255, 0, 0); // 1
            rgb_matrix_set_color(2, 255, 0, 0); // 2
            rgb_matrix_set_color(3, 255, 0, 0); // 3
            rgb_matrix_set_color(4, 255, 0, 0); // 4
            rgb_matrix_set_color(5, 255, 0, 0); // 5
            rgb_matrix_set_color(6, 255, 0, 0); // 6
            rgb_matrix_set_color(7, 255, 0, 0); // 7
            rgb_matrix_set_color(8, 255, 0, 0); // 8
            rgb_matrix_set_color(9, 255, 0, 0); // 9
            rgb_matrix_set_color(10, 255, 0, 0); // 0
            break;
        default:
            break;
    }
    if (host_keyboard_led_state().caps_lock) {
        rgb_matrix_set_color_all(0x8b, 0x00, 0x00);
    }
    return false;
}
