#!/usr/bin/env bash

set -euo pipefail

direction=${1:?usage: herdr-nav <left|right|up|down>}

case $direction in
  left)  key=ctrl+h ;;
  down)  key=ctrl+j ;;
  up)    key=ctrl+k ;;
  right) key=ctrl+l ;;
  *) echo "herdr-nav: bad direction '$direction'" >&2; exit 1 ;;
esac

info=$(herdr pane process-info --current)
pane_id=$(jq -r '.result.process_info.pane_id' <<<"$info")

if jq -r '.result.process_info.foreground_processes[] | .argv0, .name' <<<"$info" \
     | rg -qiw 'n?vim'; then
  herdr pane send-keys "$pane_id" "$key"
else
  herdr pane focus --direction "$direction" --current
fi
